{
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm ci --ignore-scripts",
  "framework": null,
  "redirects": [
    { "source": "/watchlist", "destination": "/watchlist/", "permanent": true },
    { "source": "/abrechnung", "destination": "/abrechnung/", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/watchlist-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/watchlist-cron.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/abrechnung/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; worker-src 'self' blob:; connect-src 'none'; font-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
