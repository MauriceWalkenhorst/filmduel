{
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm ci --ignore-scripts",
  "framework": null,
  "redirects": [
    { "source": "/watchlist", "destination": "/watchlist/", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/watchlist-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/watchlist-cron.js": {
      "maxDuration": 300
    }
  }
}
